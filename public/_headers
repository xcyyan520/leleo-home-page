# Cloudflare Pages response headers.
#
# The build emits content-hashed filenames under /assets, so a changed byte
# always means a changed URL — those can be cached for a year and never
# revalidated. Pages' default was `max-age=14400, must-revalidate`, which made
# every repeat phone visit spend a round trip per asset just to be told "no
# change". Images are not hashed, hence a shorter window.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=86400

# More specific than /img/* — listed after it so either precedence rule
# (later wins, or more specific wins) resolves to the longer window.
/img/wallpaper/*
  Cache-Control: public, max-age=604800

/css/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=3600

# Entry documents must stay fresh: they are the only place that points at the
# new asset hashes.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/thoughts.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
