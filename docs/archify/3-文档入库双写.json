  "cards": [
    {
      "dot": "cyan",
      "title": "为什么先写关系库",
      "items": [
        "chunk_id 是两个检索库的幂等键，先有它才能保证重试不重复",
        "重试按 chunk_id 覆盖写（先删旧再写新），不用查重",
        "关系库是 chunk 的权威副本，检索库丢了能重建"
      ]
    },
    {
      "dot": "orange",
      "title": "为什么秒回",
      "items": [
        "10MB 的 PDF 解析 + 几十个 chunk 向量化要几十秒",
        "同步做会卡死上传接口，运营以为页面挂了",
        "失败可重试，事务不被长耗时操作占着"
      ]
    },
    {
      "dot": "emerald",
      "title": "状态机才是真的事务",
      "items": [
        "「解析中」是给双写可能失败留的位置，不是装饰",
        "两库都成功才改「已生效」，任一步失败就留着等重试",
        "没上分布式事务：靠幂等 + 状态机，比两阶段提交便宜得多"
      ]
    }
  ]
