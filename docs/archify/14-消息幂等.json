  "cards": [
    {
      "dot": "cyan",
      "title": "幂等键必须是客户端生成的",
      "items": [
        "服务端生成就失去了「同一条消息」的含义——重发会得到新 id，去重失效",
        "号只在客户端换，网络重试、用户连点都不会换号"
      ]
    },
    {
      "dot": "rose",
      "title": "为什么先去重再落库",
      "items": [
        "顺序反了就会先写一行脏数据，再把「重复」当正常数据推给坐席",
        "重复建工单比重复消息严重得多：工单有 SLA 计时"
      ]
    }
